{
  "manifest_version": 3,
  "name": "Song Enhancer Hi-Fi",
  "version": "2.0.0",
  "description": "Automatic hi-fi enhancement for YouTube Music and YouTube: adaptive EQ, exciter, compression, stereo width and limiter.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://music.youtube.com/*",
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Song Enhancer"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "limiter.js"
      ],
      "matches": [
        "https://music.youtube.com/*",
        "https://www.youtube.com/*"
      ]
    }
  ]
}