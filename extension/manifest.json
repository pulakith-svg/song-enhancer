{
  "manifest_version": 3,
  "name": "Song Enhancer Hi-Fi",
  "version": "2.1.0",
  "description": "Automatic hi-fi enhancement for YouTube Music and YouTube: adaptive EQ, exciter, compression, stereo width and limiter.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://music.youtube.com/*",
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Song Enhancer",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "limiter.js"
      ],
      "matches": [
        "https://music.youtube.com/*",
        "https://www.youtube.com/*"
      ]
    }
  ],
  "host_permissions": [
    "https://raw.githubusercontent.com/pulakith-svg/song-enhancer/*"
  ],
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}